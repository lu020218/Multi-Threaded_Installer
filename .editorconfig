root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hpp}]
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

[*.{bat,cmd}]
# 保留 Windows 行尾，避免脚本被改写。
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
