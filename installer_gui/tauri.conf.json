{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Installer",
  "version": "0.1.0",
  "identifier": "com.installer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Installer",
        "label": "main",
        "width": 600,
        "height": 450,
        "minWidth": 600,
        "minHeight": 450,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "fullscreen": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "visible": true,
        "focus": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customui:; script-src 'self' customui: 'unsafe-inline' 'unsafe-eval'; style-src 'self' customui: 'unsafe-inline'; img-src 'self' customui: data: asset: https://asset.localhost blob:; connect-src ipc: http://ipc.localhost customui:; font-src 'self' customui: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": []
  },
  "plugins": {}
}
