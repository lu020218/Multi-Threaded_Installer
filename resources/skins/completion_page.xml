<?xml version="1.0" encoding="utf-8"?>

<VerticalLayout name="completion_page" padding="40,30,40,30">

    

    <HorizontalLayout height="80">

        <Control/>

        <Control name="app_logo_completion" width="64" height="64" bkcolor="#FF4A90E2"/>

        <Control/>

    </HorizontalLayout>

    

    

    <Label name="app_name_completion" text="应用程序名称" font="2" 

           textcolor="#FF333333" align="center" height="30"/>

    <Label name="app_version_completion" text="版本 1.0.0" font="0" 

           textcolor="#FF666666" align="center" height="25"/>

    

    

    <Label name="result_message" text="安装成功！" font="1" textcolor="#FF4CAF50"
           align="center" padding="0,30,0,0" height="40"/>

    

    

    <VerticalLayout padding="0,30,0,0">

        <CheckBox name="run_app_checkbox" resourcetext="true" text="msg.run_app" height="30" tabstop="true"/>

        <Control height="10"/>

        <CheckBox name="open_web_checkbox" resourcetext="true" text="msg.open_web" height="30" tabstop="true"/>

    </VerticalLayout>

    

    

    <Control/>

    

    

    <HorizontalLayout height="35">

        <Control/>

        <Button name="finish_button" resourcetext="true" text="msg.finish_action" width="100" height="35" tabstop="true"/>

    </HorizontalLayout>

</VerticalLayout>

