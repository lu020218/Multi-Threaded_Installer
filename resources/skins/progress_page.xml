<?xml version="1.0" encoding="utf-8"?>
<Windows>
<VerticalLayout name="progress_page">

    <VerticalLayout padding="20,10,20,0" height="160">
        <!-- 轮播区：原生 AnimationTabLayout，切换时左右滑动；每项 = 左文字 + 右图片，一起滑动 -->
        <AnimationTabLayout name="carousel_tab" height="130">
            <HorizontalLayout>
                <VerticalLayout width="200">
                    <Control height="20"/>
                    <Text resourcetext="true" text="msg.carousel.text1" font="1" textcolor="#FF333333" height="90"/>
                </VerticalLayout>
                <Control width="20"/>
                <Control name="carousel_img_0" width="260" bkimage="images/carousel/en_US/1.png"/>
            </HorizontalLayout>
            <HorizontalLayout>
                <VerticalLayout width="200">
                    <Control height="20"/>
                    <Text resourcetext="true" text="msg.carousel.text2" font="1" textcolor="#FF333333" height="90"/>
                </VerticalLayout>
                <Control width="20"/>
                <Control name="carousel_img_1" width="260" bkimage="images/carousel/en_US/2.png"/>
            </HorizontalLayout>
            <HorizontalLayout>
                <VerticalLayout width="200">
                    <Control height="20"/>
                    <Text resourcetext="true" text="msg.carousel.text3" font="1" textcolor="#FF333333" height="90"/>
                </VerticalLayout>
                <Control width="20"/>
                <Control name="carousel_img_2" width="260" bkimage="images/carousel/en_US/3.png"/>
            </HorizontalLayout>
        </AnimationTabLayout>
        <Control height="6"/>
        <!-- 圆点导航（固定，不随滑动）-->
        <HorizontalLayout height="16" padding="20,0,0,0">
            <!-- 用 Option（单选组）实现：选中态原生切换为椭圆图，未选中为圆点，无需代码切图 -->
            <Option name="carousel_dot_0" group="carousel_dots" selected="true" width="28" height="16"
                    normalimage="file='images\dot_inactive.png' dest='6,0,22,16'"
                    selectedimage="file='images\dot_active.png' dest='0,0,28,16'"/>
            <Control width="8"/>
            <Option name="carousel_dot_1" group="carousel_dots" width="28" height="16"
                    normalimage="file='images\dot_inactive.png' dest='6,0,22,16'"
                    selectedimage="file='images\dot_active.png' dest='0,0,28,16'"/>
            <Control width="8"/>
            <Option name="carousel_dot_2" group="carousel_dots" width="28" height="16"
                    normalimage="file='images\dot_inactive.png' dest='6,0,22,16'"
                    selectedimage="file='images\dot_active.png' dest='0,0,28,16'"/>
            <Control/>
        </HorizontalLayout>
    </VerticalLayout>

    <VerticalLayout padding="40,40,0,0">
        <Label name="current_folder" text="正在准备安装..." height="30" 
               textcolor="#FF333333"/>
        <Control height="10"/>
        <Progress name="progress_bar" value="0" width="480" height="25" 
                  bkcolor="#FFE0E0E0" forecolor="#FF4CAF50"/>
        <Control height="10"/>
        <HorizontalLayout height="25">
            <Label name="progress_percent" text="0%" textcolor="#FF666666"/>
            <Control/>
            <Label name="estimated_time" text="预计剩余时间: 计算中..." 
                   textcolor="#FF666666"/>
        </HorizontalLayout>
    </VerticalLayout>
    <Control/>
</VerticalLayout>
</Windows>