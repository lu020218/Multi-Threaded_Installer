<?xml version="1.0" encoding="utf-8"?>
<Windows>
<VerticalLayout name="progress_page">
    <Control padding="240,95,0,0" width="80" height="80" bkimage="images/logo1.png" />

    <Label visible="true" name="app_name_progress" padding="20,10,20,0" height="22" font="1" align="center" textcolor="0xFF666666" text="客户端平台" />
    <Label name="app_version_progress" text="版本 1.0.0" font="0" textcolor="#FF666666" align="center" height="25"/>
    
    <VerticalLayout padding="40,40,0,0">
        <Label name="current_folder" text="正在准备安装..." height="30" 
               textcolor="#FF333333"/>
        <Control height="10"/>
        <Progress name="progress_bar" value="0" width="480" height="25" 
                  bkcolor="#FFE0E0E0" forecolor="#FF4CAF50"/>
        <Control height="10"/>
        <HorizontalLayout height="25">
            <Label name="progress_percent" text="0%" textcolor="#FF666666"/>
            <Control/>
            <Label name="estimated_time" text="预计剩余时间: 计算中..." 
                   textcolor="#FF666666"/>
        </HorizontalLayout>
    </VerticalLayout>
    <Control/>
</VerticalLayout>
</Windows>