<?xml version="1.0" encoding="utf-8"?>
<Window>
<VerticalLayout name="uninstall_confirm_page" padding="40,30,40,30">
    <HorizontalLayout height="80">
        <Control/>
        <Control width="64" height="64" bkimage="images/uninstlogo.png"/>
        <Control/>
    </HorizontalLayout>

    <Label name="app_name_uninstall" text="应用程序名称" font="2"
           textcolor="#FF333333" align="center" height="30"/>
    <Label name="app_version_uninstall" text="版本 1.0.0" font="0"
           textcolor="#FF666666" align="center" height="25"/>

    <Label resourcetext="true" text="msg.uninstall_desc" font="0"
           textcolor="#FF666666" align="center" padding="0,20,0,0" height="24"/>

    <Control/>

    <HorizontalLayout height="35">
        <Control/>
        <Button name="btnUninstallCancel" resourcetext="true" text="msg.uninstall_cancel" width="100" height="35"/>
        <Control width="12"/>
        <Button name="btnUninstallConfirm" resourcetext="true" text="msg.uninstall_confirm" width="100" height="35"/>
    </HorizontalLayout>
</VerticalLayout>
</Window>
