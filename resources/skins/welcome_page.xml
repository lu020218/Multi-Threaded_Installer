<?xml version="1.0" encoding="utf-8"?>
<!-- 安装目录 -->
<Windows>
    <VerticalLayout >
        <Control padding="240,95,0,0" width="80" height="80" bkimage="images\logo1.png" />

        <Label visible="true" name="instinfo" padding="20,10,20,0" height="22" font="1" align="center" textcolor="0xFF666666" resourcetext="true" text="msg.instinfo" />

        <Button name="btnInstall" textcolor="0xFFFFFFFF" visible="true" resourcetext="true" cursor="hand" width="140" height="36" font="1" padding="210,30,210,0" normalimage="file='images\round_dark.png'" hotimage="file='images\round_dark_hover.png' " pushedimage="file='images\round_dark_push.png'" align="center" text="msg.install"/>
        
        <HorizontalLayout padding="10,0,0,0" height="16">
            <HorizontalLayout name="license_layer" visible="true">
                <CheckBox name="chkAgree" width="110" font="0" textcolor="0xFFFFFFFF" resourcetext="true" text="msg.agree" selectedimage="file='images\check_blue.png' dest='0,0,16,16'" normalimage="file='images\check_darkgray.png' dest='0,0,16,16'"/>
                <Button name="btnAgreement" cursor="hand" padding="-10,0,0,0" resourcetext="true" text="msg.licence" showhtml="true" textcolor="#FF0091FF" font="0" width="160" align="left" height="16"/>
            </HorizontalLayout>
            <Control width="250"/> 
            <Button name="btnShowMore" visible="true" textcolor="0xFFFFFFFF" cursor="hand" normalimage="file='images\browse.png' dest='0,1,16,16'" hotimage="file='images\browse.png' dest='0,1,16,16'" pushedimage="file='images\browse.png' dest='0,1,16,16'" resourcetext="true" text="msg.customize" textpadding="20,2,0,0" align="left"/>
        </HorizontalLayout>

        <VerticalLayout name="config-bottom" height="110" visible="false">
            <VerticalLayout name="moreinfo" visible="false" padding="20,33,0,0">
                <HorizontalLayout height="36" >
                <RichEdit name="editDir" width="444" text="" bordersize="1" bkcolor="0x80EDF7FF" textcolor="0xFF333333" font="0" inset="10,8,34,1" autohscroll="true" wanttab="false" wantreturn="false" wantctrlreturn="false" multiline="false" />
                <Button name="btnSelectDir" resourcetext="true" text="msg.browse" padding="10,0,0,0" cursor="hand" width="66" height="36" bordersize="1" bkcolor="0xFFEDF7FF" bordercolor="0xFFC2E1F9" hotbkcolor="0xFFE0F1FE" pushedbkcolor="0xFFD0E7F9" textcolor="0xFF060300" hottextcolor="0xFF060300" pushedtextcolor="0xFF060300" disabledtextcolor="0xFF060300" textpadding="0,-1,0,0" align="center" />
                </HorizontalLayout>
                    <HorizontalLayout padding="0,28,0,0" height="16">
                    <CheckBox name="chkAutoRun" width="95" font="0" textcolor="0xFFFFFFFF" resourcetext="true" text="msg.autostart" selectedimage="file='images\check_blue.png' dest='0,0,16,16'" normalimage="file='images\check_darkgray.png' dest='0,0,16,16'"/>
                    <CheckBox name="chkShotcut" padding="20,0,0,0" textcolor="0xFFFFFFFF" width="118" font="0" resourcetext="true" text="msg.createshortcut" selectedimage="file='images\check_blue.png' dest='0,0,16,16'" normalimage="file='images\check_darkgray.png' dest='0,0,16,16'"/>
                </HorizontalLayout>
            </VerticalLayout>
        </VerticalLayout>
    </VerticalLayout>
</Windows>

