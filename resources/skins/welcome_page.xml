<?xml version="1.0" encoding="utf-8"?>
<!-- 安装目录 -->
<Windows>
    <VerticalLayout >
        <control height="50"/>
        <VerticalLayout name="config-top" height="112" visible="true">
            <HorizontalLayout height="80">
                <Control width="stretch"/>
                <Control padding="0,0,0,0" width="80" height="80" bkimage="images\logo1.png" />
                <Control width="stretch"/>
            </HorizontalLayout>
            <HorizontalLayout height="22" padding="0,10,0,0">
                <Control width="stretch"/>
                <Label visible="true" name="instinfo" height="22" font="1" align="center" textcolor="0xFF666666" resourcetext="true" text="msg.instinfo" />
                <Control width="stretch"/>
            </HorizontalLayout>
        </VerticalLayout>
        <control height="10"/>
        <VerticalLayout height="42">
            <HorizontalLayout height="16">
                <Control width="stretch"/>
                <CheckBox name="chkChrome" userdata="component:chrome" width="60" font="0" textcolor="0xFFFFFFFF" resourcetext="true" text="msg.pluginInstall" selectedimage="file='images\check_blue.png' dest='0,0,16,16'" normalimage="file='images\check_darkgray.png' dest='0,0,16,16'"/>
                <Button name="btnChrome" cursor="hand" padding="0,0,0,0" resourcetext="true" text="msg.chromePlugin" showhtml="true" textcolor="#FF0091FF" font="0" width="100" align="left" height="16"/>
                <Control width="stretch"/>
            </HorizontalLayout>
        </VerticalLayout>
        <control height="50"/>
        <HorizontalLayout height="36">
            <Control width="stretch"/>
            <Button name="btnInstall" textcolor="0xFFFFFFFF" visible="true" resourcetext="true" cursor="hand" width="140" height="36" font="1" normalimage="file='images\round_dark.png'" hotimage="file='images\round_dark_hover.png' " pushedimage="file='images\round_dark_push.png'" align="center" text="msg.install"/>
            <Control width="stretch"/>
        </HorizontalLayout>
        <control height="65"/>
        <HorizontalLayout height="16" padding="15,0,10,0">
            <HorizontalLayout name="license_layer" visible="true">
                <CheckBox name="license_checkbox" width="110" font="0" padding="0,0,0,0" textcolor="0xFFFFFFFF" resourcetext="true" text="msg.agree" selectedimage="file='images\check_blue.png' dest='0,0,16,16'" normalimage="file='images\check_darkgray.png' dest='0,0,16,16'"/>
                <Button name="btnAgreement" cursor="hand" padding="0,0,0,0" resourcetext="true" text="msg.licence" showhtml="true" textcolor="#FF0091FF" font="0" width="160" align="left" height="16"/>
            </HorizontalLayout>
            <Control width="stretch"/> 
            <Button name="btnShowMore" width="80" visible="true" textcolor="0xFFFFFFFF" cursor="hand" normalimage="file='images\browse.png' dest='0,1,16,16'" hotimage="file='images\browse.png' dest='0,1,16,16'" pushedimage="file='images\browse.png' dest='0,1,16,16'" resourcetext="true" text="msg.customize" textpadding="20,2,0,0" align="left"/>
        </HorizontalLayout>

        <HorizontalLayout name="config-bottom" height="75" visible="false">
            <VerticalLayout name="moreinfo" visible="false" width="580" padding="15,0,0,0">
                <Label name="disk_space_info" text="" height="22" textcolor="#FF666666" align="left" padding="0,6,0,6"/>
                <HorizontalLayout height="36" >
                    <RichEdit name="editDir" width="500" text="" bordersize="1" bkcolor="0x80EDF7FF" textcolor="0xFF333333" font="0" inset="10,8,34,1" autohscroll="true" wanttab="false" wantreturn="false" wantctrlreturn="false" multiline="false" />
                    <Button name="btnSelectDir" resourcetext="true" text="msg.browse" padding="10,0,0,0" cursor="hand" width="70" height="36" bordersize="1" bkcolor="0xFFEDF7FF" bordercolor="0xFFC2E1F9" hotbkcolor="0xFFE0F1FE" pushedbkcolor="0xFFD0E7F9" textcolor="0xFF060300" hottextcolor="0xFF060300" pushedtextcolor="0xFF060300" disabledtextcolor="0xFF060300" textpadding="0,-1,0,0" align="center" />
                </HorizontalLayout>
                    <HorizontalLayout padding="0,28,0,0" height="16">
                    <CheckBox name="chkAutoRun" width="95" font="0" textcolor="0xFFFFFFFF" resourcetext="true" text="msg.autostart" selectedimage="file='images\check_blue.png' dest='0,0,16,16'" normalimage="file='images\check_darkgray.png' dest='0,0,16,16'"/>
                    <CheckBox name="chkShotcut" padding="20,0,0,0" textcolor="0xFFFFFFFF" width="118" font="0" resourcetext="true" text="msg.createshortcut" selectedimage="file='images\check_blue.png' dest='0,0,16,16'" normalimage="file='images\check_darkgray.png' dest='0,0,16,16'"/>
                </HorizontalLayout>
            </VerticalLayout>
        </HorizontalLayout>
        <Control />
    </VerticalLayout>
</Windows>
